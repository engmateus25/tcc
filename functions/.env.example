# Backend endpoint called by the Firestore trigger.
BACKEND_SENSOR_EVENT_URL=http://127.0.0.1:8000/alerts/sensor-event

# Optional in local development. In production, fill this with the same value
# configured in backend SENSOR_EVENT_WEBHOOK_SECRET.
SENSOR_EVENT_WEBHOOK_SECRET=

# Optional runtime configuration used by the source code.
FUNCTION_REGION=us-central1
