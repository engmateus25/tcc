CORS_ORIGINS=http://localhost:8100,https://localhost:8100,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ======= LLM =======
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2:0.5b

# ======= OpenAI (opcional) =======
# OPENAI_API_KEY= 
# OPENAI_MODEL=gpt-4o-mini

# ======= FIREBASE ADMIN (via caminho do arquivo) =======
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
# FIREBASE_CREDENTIALS_JSON=   # (deixe em branco nesta opção)

# ======= SCHEDULER =======
ENABLE_SCHEDULER=0
SCHEDULE_CRON_WEEKLY=0 7 * * 1
SCHEDULE_CRON_MONTHLY=0 7 1 * *

# ======= RELATÓRIOS =======
FIRESTORE_SENSORS_COLLECTION=sensores
FIRESTORE_ALERTS_COLLECTION=alerts
FIRESTORE_SENSOR_EVENT_PROCESSING_COLLECTION=sensor_event_processing
FIRESTORE_FILLING_CYCLES_COLLECTION=filling_cycles
FIRESTORE_OPERATION_TIMEOUT_SECONDS=10
PDF_OUTPUT_DIR=./generated

# ======= WEBHOOK DE EVENTOS DE SENSOR =======
# Quando definido, o endpoint POST /alerts/sensor-event exige o header:
# X-AquaMonitor-Webhook-Secret: <valor>
SENSOR_EVENT_WEBHOOK_SECRET=

# ======= REGRAS DE SENSORES E CICLOS =======
SENSOR_DUPLICATE_WINDOW_SECONDS=5
SENSOR_OUT_OF_ORDER_TOLERANCE_SECONDS=2
MIN_PLAUSIBLE_DRAIN_TIME_SECONDS=60
FILL_TIME_MIN_SAMPLES=5
FILL_TIME_SLOW_FACTOR=1.5
FILL_TIME_PERSISTENT_WINDOW=3
