CORS_ORIGINS=http://localhost:8100,https://localhost:8100,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://192.168.0.104:5173

# ======= LLM =======
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_SECONDS=600

# ======= Gemini / Google AI Studio (opcional) =======
# Nunca exponha esta chave no frontend. Use LLM_PROVIDER=gemini para ativar.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60

# ======= OpenAI (opcional) =======
# OPENAI_API_KEY= 
# OPENAI_MODEL=gpt-4o-mini

# ======= Agente analítico =======
# hybrid tenta LLM e retorna fallback deterministico identificado se o provedor falhar.
# deterministic nao chama LLM. llm exige o provedor, salvo se fallback estiver habilitado.
AGENT_RESPONSE_MODE=hybrid
AGENT_ALLOW_DETERMINISTIC_FALLBACK=1
AGENT_SEND_RAW_EVENTS_TO_LLM=0
AGENT_MAX_HISTORY_MESSAGES=8

# ======= FIREBASE ADMIN (via caminho do arquivo) =======
GOOGLE_APPLICATION_CREDENTIALS=/home/mateus/Projetos/tcc/backend/credentials.json

# ======= SCHEDULER =======
ENABLE_SCHEDULER=0
SCHEDULE_CRON_WEEKLY=0 7 * * 1
SCHEDULE_CRON_MONTHLY=0 7 1 * *

# ======= RELATÓRIOS =======
FIRESTORE_SENSORS_COLLECTION=sensores
FIRESTORE_COMMANDS_COLLECTION=comandos
FIRESTORE_ALERTS_COLLECTION=alerts
FIRESTORE_SENSOR_EVENT_PROCESSING_COLLECTION=sensor_event_processing
FIRESTORE_FILLING_CYCLES_COLLECTION=filling_cycles
FIRESTORE_OPERATION_TIMEOUT_SECONDS=10
PDF_OUTPUT_DIR=./generated

# ======= CONSUMO DE ÁGUA E ENERGIA =======
RESERVOIR_VOLUME_BETWEEN_SENSORS_LITERS=500
WATER_PRICE_PER_CUBIC_METER_BRL=8.00
PUMP_POWER_KW=0.75
ELECTRICITY_PRICE_PER_KWH_BRL=0.656

# ======= WEBHOOK DE EVENTOS DE SENSOR =======
# Quando definido, o endpoint POST /alerts/sensor-event exige o header:
# X-AquaMonitor-Webhook-Secret: <valor>
SENSOR_EVENT_WEBHOOK_SECRET=

# ======= REGRAS DE SENSORES E CICLOS =======
SENSOR_DUPLICATE_WINDOW_SECONDS=5
SENSOR_OUT_OF_ORDER_TOLERANCE_SECONDS=2
MIN_PLAUSIBLE_DRAIN_TIME_SECONDS=60
FILL_TIME_MIN_SAMPLES=5
FILL_TIME_SLOW_FACTOR=1.5
FILL_TIME_PERSISTENT_WINDOW=3
